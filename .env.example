# ─────────────────────────────────────────────────────────────────────────────
# Facebook Ad Library Downloader — Environment Variables
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
#
# Note: docker-compose.yml overrides REDIS_URL with the Docker service name
# (redis://redis:6379/0) so containers can reach each other.  The value below
# is for running services directly on the host.
# ─────────────────────────────────────────────────────────────────────────────

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO   # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ── RQ Worker ──────────────────────────────────────────────────────────────
RQ_QUEUES=high,default,low
RQ_BURST=false          # Set to true to exit after processing all queued jobs
RQ_WORKER_NAME=         # Leave blank for auto-generated names

# ── Frontend ───────────────────────────────────────────────────────────────
# Used by Next.js rewrites (next.config.js) to proxy /api/* requests.
# Inside Docker this is overridden to http://api:8000 by docker-compose.yml.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Optional: Facebook API token (if using the official Graph API) ─────────
# FB_ACCESS_TOKEN=your_token_here
