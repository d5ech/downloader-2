# ─────────────────────────────────────────────────────────────────────────────
# Facebook Ad Library Downloader — Environment Variables
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── File storage ───────────────────────────────────────────────────────────
# Directory where downloaded assets are saved (relative to /app inside Docker)
DOWNLOAD_ROOT=media/downloads

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO   # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ── RQ Worker ──────────────────────────────────────────────────────────────
RQ_QUEUES=default
RQ_BURST=false          # Set to true to exit after processing all queued jobs
RQ_WORKER_NAME=         # Leave blank for auto-generated names

# ── Frontend ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Optional: Facebook API token (if using the official Graph API) ─────────
# FB_ACCESS_TOKEN=your_token_here
