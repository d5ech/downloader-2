# ============================================================
# Stage 1 — Install Node dependencies
# ============================================================
FROM node:20-alpine AS deps

WORKDIR /app
COPY frontend/package.json ./
# Use npm install (not npm ci) — no lock file required in repo.
RUN npm install

# ============================================================
# Stage 2 — Development (hot-reload via volume mount)
# Used by docker-compose.yml: target: dev
# Source is mounted at runtime; node_modules stay in the image.
# ============================================================
FROM deps AS dev

EXPOSE 3000
CMD ["npm", "run", "dev"]

# ============================================================
# Stage 3 — Production build
# ============================================================
FROM deps AS builder

COPY frontend/ .
RUN npm run build

# ============================================================
# Stage 4 — Production runtime (standalone)
# ============================================================
FROM node:20-alpine AS runner

ENV NODE_ENV=production

WORKDIR /app

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

EXPOSE 3000
ENV PORT=3000

CMD ["node", "server.js"]
